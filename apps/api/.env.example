# Copy to .env and fill in. The API validates these at startup (src/config/env.validation.ts)
# and refuses to boot if JWT_SECRET is missing — there is no in-code default.

# Required. Generate with: openssl rand -base64 48
# Must be >= 32 chars. A placeholder value aborts startup when NODE_ENV=production.
JWT_SECRET=

# Required. Postgres — see docker-compose.yml for a local one, or point this at
# an existing server. SQLite is no longer supported: the schema and migrations
# are Postgres-specific, and `contains` searches rely on `mode: 'insensitive'`,
# which SQLite does not implement.
DATABASE_URL="postgresql://postgres:password@localhost:5432/gcoms_db?schema=public"

# Only for `npx jest --config ./test/jest-e2e.json`. The e2e specs create and
# drop a schema of their own on each run, and refuse to start if this is unset
# or equal to DATABASE_URL — they are not safe to point at a database you care
# about.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/gcoms_e2e"

# Shared by every seeded account, so it exists for local convenience only. Unset
# it and the seed generates a random password and prints it once. The seed
# refuses to run at all when NODE_ENV=production.
# SEED_PASSWORD="at-least-twelve-characters"

JWT_EXPIRES_IN="60m"
PORT=3001

# Failed-login throttling, per window (default 60s).
#   LOGIN_RATE_LIMIT        attempts against a single account, from anywhere
#   LOGIN_SOURCE_RATE_LIMIT attempts from a single address, across all accounts
LOGIN_RATE_LIMIT=5
LOGIN_SOURCE_RATE_LIMIT=30
LOGIN_RATE_TTL_MS=60000

# Required if the API sits behind a load balancer or reverse proxy, otherwise
# every client resolves to the proxy address and shares one rate-limit bucket.
# Set to the number of proxy hops ("1"), or a comma-separated list of proxy
# addresses. Leave unset for a direct connection. Avoid "true": it trusts any
# X-Forwarded-For, which a caller can forge to evade rate limiting entirely.
# TRUST_PROXY=1

# Comma-separated origins permitted to call this API from a browser. Required in
# production — an empty value aborts startup rather than silently allowing none.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Optional. Without these, notifications are recorded in the outbox with status
# PENDING and logged, but not delivered. Set them and the same messages send.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@gcoms.org"

# Where uploaded documents are written. Defaults to ./storage/documents,
# which is outside the web root. Point this at a mounted volume in a container.
# UPLOAD_DIR=/var/lib/gcoms/documents
