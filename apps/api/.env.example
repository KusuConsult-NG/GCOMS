# Copy to .env and fill in. The API validates these at startup (src/config/env.validation.ts)
# and refuses to boot if JWT_SECRET is missing — there is no in-code default.

# Required. Generate with: openssl rand -base64 48
# Must be >= 32 chars. A placeholder value aborts startup when NODE_ENV=production.
JWT_SECRET=

# Required.
DATABASE_URL="file:./dev.db"

JWT_EXPIRES_IN="60m"
PORT=3001

# Comma-separated origins permitted to call this API from a browser. Required in
# production — an empty value aborts startup rather than silently allowing none.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# NOTE: currently unused — NotificationsService only logs mock emails/SMS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@gcoms.org"
