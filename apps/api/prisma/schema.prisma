generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String   @default("COMMUNITY_HEALTH_WORKER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants        Participant[]
  screenings          Screening[]
  clinicalEncounters  ClinicalEncounter[]
  referrals           Referral[]
  followUps           FollowUp[]
  auditLogs           AuditLog[]
  requestedApprovals  ApprovalRequest[] @relation("RequestedApprovals")
  approvedApprovals   ApprovalRequest[] @relation("ApprovedApprovals")
  financeTransactions FinanceTransaction[]
  procurementOrders   ProcurementOrder[]
  managedStaff        StaffRecord[]     @relation("ManagedStaff")
  staffRecord         StaffRecord?      @relation("UserStaffRecord")
  facilityRequests    FacilityRequest[]
  managedGrants       Grant[]           @relation("ManagedGrants")
  managedProjects     Project[]         @relation("ManagedProjects")
  managedInventory    InventoryItem[]   @relation("ManagedInventory")
  uploadedDocuments   DocumentRecord[]  @relation("UploadedDocuments")
  organizedMeetings   GovernanceMeeting[] @relation("OrganizedMeetings")
  patientAssignments  PatientAssignment[]
  volunteerTasks      VolunteerTask[]
  appointments        Appointment[]     @relation("ClinicianAppointments")
  volunteerProfile    VolunteerProfile?
}

model ApprovalRequest {
  id            String   @id @default(uuid())
  title         String
  description   String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  resourceType  String   // e.g. PROCUREMENT, FINANCE, HR, GRANT, USER
  resourceId    String?
  comments      String?
  requestedById String
  requestedBy   User     @relation("RequestedApprovals", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?    @relation("ApprovedApprovals", fields: [approvedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FinanceTransaction {
  id            String   @id @default(uuid())
  amount        Decimal
  type          String   // INCOME, EXPENSE
  category      String   // DONATION, SALARY, SUPPLIES, etc.
  description   String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProcurementOrder {
  id            String   @id @default(uuid())
  itemName      String
  quantity      Int
  estimatedCost Decimal
  vendor        String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StaffRecord {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation("UserStaffRecord", fields: [userId], references: [id])
  department     String
  employmentType String   // FULL_TIME, PART_TIME, VOLUNTEER
  status         String   @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  managedById    String?
  managedBy      User?    @relation("ManagedStaff", fields: [managedById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FacilityRequest {
  id            String   @id @default(uuid())
  facilityName  String
  requestType   String   // MAINTENANCE, BOOKING, REPAIR
  description   String
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Grant {
  id          String   @id @default(uuid())
  donorName   String
  grantName   String
  amount      Decimal
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ACTIVE") // ACTIVE, PENDING, EXHAUSTED
  managedById String
  managedBy   User     @relation("ManagedGrants", fields: [managedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones  GrantMilestone[]
  reportSchedules GrantReportSchedule[]
}

model GrantMilestone {
  id          String   @id @default(uuid())
  grantId     String
  grant       Grant    @relation(fields: [grantId], references: [id])
  title       String
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  // The milestone tracker already showed a target metric and percent complete,
  // and its form collected a description; none had anywhere to live.
  description String?
  metric      String?
  progress    Int      @default(0) // 0-100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([grantId])
}

model Project {
  id          String   @id @default(uuid())
  projectName String
  description String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("PLANNING") // PLANNING, ACTIVE, COMPLETED
  budget      Decimal
  managedById String
  managedBy   User     @relation("ManagedProjects", fields: [managedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       ProjectTask[]
  risks       ProjectRisk[]
}

model ProjectTask {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  // Added so the task board can persist what it already displayed from
  // hardcoded browser state.
  description String?
  assignee    String?
  dueDate     DateTime?
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model InventoryItem {
  id          String   @id @default(uuid())
  itemName    String
  category    String   // MEDICATION, EQUIPMENT, CONSUMABLE
  quantity    Int
  unit        String
  location    String
  status      String   @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK
  managedById String
  managedBy   User     @relation("ManagedInventory", fields: [managedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements   StockMovement[]
}

model DocumentRecord {
  id            String   @id @default(uuid())
  title         String
  documentType  String   // POLICY, GUIDELINE, REPORT
  // External link, when the document lives elsewhere. Null for uploads.
  url           String?
  // Upload metadata. Files are stored outside the web root under a generated
  // name and served only through an authenticated endpoint, because documents
  // may contain patient or financial information.
  storedName    String?  @unique
  originalName  String?
  mimeType      String?
  sizeBytes     Int?
  checksum      String?  // sha256, so a download can be proven intact
  version       String   @default("1.0")
  uploadedById  String
  uploadedBy    User     @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GovernanceMeeting {
  id            String   @id @default(uuid())
  title         String
  meetingDate   DateTime
  minutesUrl    String?
  status        String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  organizedById String
  organizedBy   User     @relation("OrganizedMeetings", fields: [organizedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  actions       BoardAction[]
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Participant {
  id               String   @id @default(uuid())
  // System-assigned at registration. Previously the client generated this and
  // wrote it into nationalId, which both collided and made it impossible to
  // record a patient's actual National Identification Number.
  registrationId   String   @unique
  nationalId       String?  @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           String
  phoneNumber      String?
  address          String?
  // Structured outreach location. These were collected by the volunteer intake
  // form and then flattened into `address` before ever reaching the database.
  lga              String?
  ward             String?
  gpsCoordinates   String?
  communityId      String?
  community        Community? @relation(fields: [communityId], references: [id])
  consentGiven     Boolean  @default(true)
  registeredById   String
  registeredBy     User     @relation(fields: [registeredById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  screenings         Screening[]
  clinicalEncounters ClinicalEncounter[]
  referrals          Referral[]
  followUps          FollowUp[]
  assignments        PatientAssignment[]
  navigationEvents   NavigationEvent[]
  vitalSigns         VitalSign[]
  medicalHistories   MedicalHistory[]
  appointments       Appointment[]
}

model VitalSign {
  id            String   @id @default(uuid())
  bpSystolic    Int?
  bpDiastolic   Int?
  pulseRate     Int?
  temperature   Float?
  weightKg      Float?
  heightCm      Float?
  bmi           Float?
  oxygenSat     Float?
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  recordedAt    DateTime @default(now())
}

model MedicalHistory {
  id            String   @id @default(uuid())
  conditionName String
  diagnosisDate DateTime?
  familyHistory String?
  lifestyleNotes String?
  allergies     String?
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  createdAt     DateTime @default(now())
}

model Appointment {
  id            String   @id @default(uuid())
  scheduledAt   DateTime
  type          String   @default("FOLLOW_UP") // SCREENING, CLINICAL, FOLLOW_UP
  status        String   @default("SCHEDULED") // SCHEDULED, COMPLETED, MISSED, CANCELLED
  notes         String?
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  clinicianId   String
  clinician     User     @relation("ClinicianAppointments", fields: [clinicianId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationItem {
  id            String   @id @default(uuid())
  recipient     String
  channel       String   @default("EMAIL") // EMAIL, SMS, PUSH
  subject       String
  body          String
  status        String   @default("SENT") // PENDING, SENT, FAILED
  sentAt        DateTime @default(now())
}

model Location {
  id        String   @id @default(uuid())
  name      String
  address   String?
  lga       String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screenings Screening[]
  outreaches Outreach[]
}

model Screening {
  id             String   @id @default(uuid())
  cancerType     String
  result         String
  riskScore      Float?
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id])
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id])
  conductedById  String
  conductedBy    User     @relation(fields: [conductedById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClinicalEncounter {
  id            String   @id @default(uuid())
  notes         String
  prognosis     String?
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  clinicianId   String
  clinician     User     @relation(fields: [clinicianId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  investigations Investigation[]
  auditLogs      AuditLog[]
}

model Investigation {
  id                  String   @id @default(uuid())
  type                String
  results             String?
  // "Make recommendations with regards to results from investigation" was a
  // stated requirement with no field behind it.
  recommendation      String?
  clinicalEncounterId String
  clinicalEncounter   ClinicalEncounter @relation(fields: [clinicalEncounterId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Referral {
  id             String   @id @default(uuid())
  referredTo     String
  reason         String
  status         String   @default("PENDING")
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id])
  referredById   String
  referredBy     User     @relation(fields: [referredById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FollowUp {
  id            String   @id @default(uuid())
  scheduledDate DateTime
  notes         String?
  status        String   @default("SCHEDULED")
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  clinicianId   String
  clinician     User     @relation(fields: [clinicianId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id                  String   @id @default(uuid())
  action              String
  oldData             String?
  newData             String?
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  clinicalEncounterId String?
  clinicalEncounter   ClinicalEncounter? @relation(fields: [clinicalEncounterId], references: [id])
  createdAt           DateTime @default(now())
}

model PatientAssignment {
  id            String   @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  clinicianId   String
  clinician     User     @relation(fields: [clinicianId], references: [id])
  status        String   @default("ACTIVE")
  assignedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StrategicGoal {
  id            String   @id @default(uuid())
  title         String
  targetMetric  Float
  currentMetric Float    @default(0)
  deadline      DateTime
  status        String   @default("ON_TRACK")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Outreach {
  id            String   @id @default(uuid())
  title         String
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  date          DateTime
  attendance    Int      @default(0)
  status        String   @default("PLANNED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks         VolunteerTask[]
}

model VolunteerTask {
  id            String   @id @default(uuid())
  title         String
  outreachId    String
  outreach      Outreach @relation(fields: [outreachId], references: [id])
  volunteerId   String
  volunteer     User     @relation(fields: [volunteerId], references: [id])
  hoursLogged   Float    @default(0)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NavigationEvent {
  id            String   @id @default(uuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  eventType     String
  date          DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ResearchProject {
  id            String   @id @default(uuid())
  title         String
  status        String   @default("ACTIVE")
  progress      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Community {
  id            String   @id @default(uuid())
  name          String
  lga           String
  state         String   @default("Plateau")
  population    Int      @default(0)
  leaderName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants  Participant[]
}

model Appraisal {
  id            String   @id @default(uuid())
  employeeId    String
  reviewerId    String
  period        String
  score         Float
  comments      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LeaveRequest {
  id            String   @id @default(uuid())
  employeeId    String
  startDate     DateTime
  endDate       DateTime
  type          String   @default("ANNUAL")
  status        String   @default("PENDING")
  // The leave screen already collected a reason with nowhere to store it.
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BankReconciliation {
  id              String   @id @default(uuid())
  statementDate   DateTime
  bankBalance     Float
  ledgerBalance   Float
  discrepancy     Decimal  @default(0)
  status          String   @default("RECONCILED") // RECONCILED, DISCREPANCY, PENDING
  notes           String?
  createdAt       DateTime @default(now())
}

model EquipmentServiceLog {
  id              String   @id @default(uuid())
  inventoryItemId String
  serviceType     String   // CALIBRATION, PREVENTIVE_MAINTENANCE, REPAIR
  performedBy     String
  serviceDate     DateTime
  nextDueDate     DateTime
  cost            Float    @default(0)
  status          String   @default("COMPLETED")
  notes           String?
  createdAt       DateTime @default(now())
}

model BoardResolution {
  id              String   @id @default(uuid())
  resolutionNo    String   @unique
  title           String
  description     String
  votesFor        Int      @default(0)
  votesAgainst    Int      @default(0)
  abstentions     Int      @default(0)
  status          String   @default("PASSED") // PASSED, REJECTED, PENDING
  passedDate      DateTime @default(now())
}

model OnboardingChecklist {
  id              String   @id @default(uuid())
  employeeName    String
  role            String
  identityVerified Boolean @default(true)
  contractSigned  Boolean  @default(true)
  itProvisioned   Boolean  @default(true)
  medicalCleared  Boolean  @default(true)
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())
}

model GrantProposal {
  id              String   @id @default(uuid())
  title           String
  donorName       String
  requestedAmount Decimal
  submissionDeadline DateTime
  status          String   @default("UNDER_REVIEW") // DRAFT, UNDER_REVIEW, SUBMITTED, AWARDED, REJECTED
  leadAuthor      String
  createdAt       DateTime @default(now())
}


// ---------------------------------------------------------------------------
// Records that the UI has always displayed from hardcoded browser arrays. Field
// shapes are taken from those arrays so nothing the screens already show is
// lost. SQLite has no array type, so list-valued fields (committees, interests)
// are stored comma-separated and documented as such.
// ---------------------------------------------------------------------------

model JobOpening {
  id          String   @id @default(uuid())
  title       String
  department  String
  employmentType String @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT
  location    String
  deadline    DateTime
  description String?
  status      String   @default("OPEN") // OPEN, CLOSED, FILLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicants  JobApplicant[]
}

model JobApplicant {
  id           String   @id @default(uuid())
  jobOpeningId String
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  phone        String?
  stage        String   @default("APPLIED") // APPLIED, INTERVIEW, OFFER, ACCEPTED, REJECTED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([jobOpeningId])
}

model TrainingRecord {
  id          String   @id @default(uuid())
  staffId     String?  // User id when the trainee is a system user
  staffName   String
  title       String
  provider    String?
  type        String   @default("CLINICAL_SKILLS")
  trainingDate DateTime
  certified   Boolean  @default(false)
  expiryDate  DateTime?
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, PENDING
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VolunteerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lga       String
  ward      String?
  address   String?
  stipend   Decimal  @default(0)
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoardMember {
  id         String   @id @default(uuid())
  name       String
  title      String?
  role       String   @default("MEMBER") // CHAIRPERSON, VICE_CHAIRPERSON, SECRETARY, MEMBER, PATRON
  committees String?  // comma-separated; SQLite has no array type
  phone      String?
  email      String?
  termStart  DateTime
  termEnd    DateTime
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BoardAction {
  id          String   @id @default(uuid())
  description String
  responsible String
  dueDate     DateTime
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  meetingId   String?
  meeting     GovernanceMeeting? @relation(fields: [meetingId], references: [id])
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([meetingId])
}

model StockMovement {
  id              String   @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  type            String   // STOCK_RECEIPT, STOCK_ISSUE, TRANSFER, ADJUSTMENT, DISPOSAL
  quantity        Int
  fromLocation    String?
  toLocation      String?
  reference       String?
  authorisedBy    String?
  movementDate    DateTime @default(now())
  remarks         String?
  createdAt       DateTime @default(now())

  @@index([inventoryItemId])
}

model ProjectRisk {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  category   String   @default("OPERATIONAL")
  likelihood String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  impact     String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  score      Int      @default(0)        // derived from likelihood x impact
  mitigation String?
  owner      String?
  status     String   @default("OPEN")   // OPEN, MITIGATING, CLOSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
}

model Donor {
  id          String   @id @default(uuid())
  organisation String  @unique
  country     String?
  type        String   @default("MULTILATERAL") // MULTILATERAL, BILATERAL, FOUNDATION, CORPORATE, INDIVIDUAL
  contactName String?
  contactTitle String?
  email       String?
  phone       String?
  interests   String?  // comma-separated
  lastContact DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GrantReportSchedule {
  id        String   @id @default(uuid())
  grantId   String
  grant     Grant    @relation(fields: [grantId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("QUARTERLY") // QUARTERLY, SEMI_ANNUAL, ANNUAL, SPECIAL
  dueDate   DateTime
  officer   String?
  status    String   @default("UPCOMING") // UPCOMING, SUBMITTED, LATE
  submittedAt DateTime?
  reference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grantId])
}

model Vendor {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?
  rating    Float    @default(0)
  taxId     String?
  status    String   @default("PENDING") // PENDING, VERIFIED, SUSPENDED
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes    RfqQuote[]
}

model Rfq {
  id          String   @id @default(uuid())
  reference   String   @unique
  description String
  status      String   @default("OPEN") // OPEN, EVALUATION, COMPLETE, CANCELLED
  closingDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes      RfqQuote[]
}

model RfqQuote {
  id        String   @id @default(uuid())
  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  price     Decimal
  warranty  String?
  score     Int      @default(0)
  status    String   @default("SUBMITTED") // SUBMITTED, RECOMMENDED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@unique([rfqId, vendorId])
}
